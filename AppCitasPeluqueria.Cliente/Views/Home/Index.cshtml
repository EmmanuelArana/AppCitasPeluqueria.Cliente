@{
    ViewData["Title"] = "Inicio";
}

<!-- Encabezado de la página -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-0">Panel de control</h1>
        <p class="text-muted mb-0" id="dashFecha">Resumen del día</p>
    </div>
    <div class="d-flex gap-2 flex-shrink-0">
        <a class="btn btn-primary" asp-controller="Citas" asp-action="Index">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>
            <span class="d-none d-sm-inline">Nueva cita</span>
        </a>
        <button type="button" class="btn btn-outline-secondary" id="btnRefrescar" title="Actualizar datos">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
</div>

<!-- Tarjetas de estadísticas -->
<div class="row g-3 g-lg-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stats-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stats-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <p class="h6 mb-0 text-muted">Total de citas</p>
                        <div class="h3 mb-0" id="statCitasTotales" aria-live="polite">-</div>
                        <small class="text-muted" id="statCitasTotalesDetalle">&nbsp;</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card stats-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stats-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <p class="h6 mb-0 text-muted">Clientes</p>
                        <div class="h3 mb-0" id="statClientes" aria-live="polite">-</div>
                        <small class="text-muted" id="statClientesDetalle">&nbsp;</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card stats-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stats-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-person-badge"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <p class="h6 mb-0 text-muted">Estilistas</p>
                        <div class="h3 mb-0" id="statEstilistas" aria-live="polite">-</div>
                        <small class="text-muted" id="statEstilistasDetalle">&nbsp;</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card stats-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="stats-icon bg-info bg-opacity-10 text-info">
                            <i class="bi bi-tags"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <p class="h6 mb-0 text-muted">Especialidades</p>
                        <div class="h3 mb-0" id="statEspecialidades" aria-live="polite">-</div>
                        <small class="text-muted" id="statEspecialidadesDetalle">&nbsp;</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@section Scripts {
    <script>
        window.apiSettings = {
            baseUrl: '@Configuration["ApiSettings:BaseUrl"]',
            endpointCita: '@Configuration["ApiSettings:EndpointCita"]',
            endpointCliente: '@Configuration["ApiSettings:EndpointCliente"]',
            endpointEstilista: '@Configuration["ApiSettings:EndpointEstilista"]',
            endpointEspecialidad: '@Configuration["ApiSettings:EndpointEspecialidad"]'
        };
    </script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/home.js" asp-append-version="true"></script>
}