@{
    ViewData["Title"] = "Página no encontrada";
}

<div class="error-page d-flex align-items-center justify-content-center text-center py-5" style="min-height: 75vh;">
    <div class="error-container px-3">
        <h1 class="error-code fw-bold text-primary mb-0" style="font-size: 8rem; line-height: 1;">404</h1>
        <h2 class="display-5 error-message fw-semibold mb-3">Página no encontrada</h2>
        <p class="lead text-secondary mx-auto mb-5" style="max-width: 520px;">
            No pudimos encontrar la página que busca. Puede que la dirección esté mal escrita o que el registro ya no exista.
        </p>
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5">Volver al inicio</a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg rounded-pill px-5">Regresar</a>
        </div>
    </div>
</div>