@{
    ViewData["Title"] = "Especialidades";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="h3 mb-0">@ViewData["Title"]</h3>
        <p class="text-muted mb-0">Administra las especialidades de la peluquería</p>
    </div>
    <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas"
            data-bs-target="#offcanvasEspecialidad" aria-controls="offcanvasEspecialidad"
            id="btnNuevaEspecialidad">
        <i class="bi bi-plus-lg me-1"></i>Nueva especialidad
    </button>
</div>

<div id="alertas"></div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-3">
        <h3 class="h5 card-title mb-0">Listado de @ViewData["Title"]</h3>
        <span class="badge text-bg-secondary" id="contadorEspecialidades">0</span>
    </div>
    <div id="errorServer" class="alert alert-danger d-none"></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-body-tertiary">
                    <tr>
                        <th>Nombre</th>
                        <th>Activo</th>
                        <th>Fecha creación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tablaEspecialidades">
                    <tr><td colspan="4" class="text-center text-muted py-4">Cargando...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Offcanvas con el formulario -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEspecialidad" aria-labelledby="tituloForm">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="tituloForm">Nueva especialidad</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body">
        <form id="formEspecialidad" novalidate>
            <div id="errorForm" class="alert alert-danger d-none"></div>
            <input type="hidden" id="inpId" />

            <div class="mb-3">
                <label for="inpNombre" class="form-label">Nombre</label>
                <input type="text" id="inpNombre" class="form-control" maxlength="100" required />
            </div>

            <div class="mb-4">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="chkActivo" checked>
                    <label class="form-check-label" for="chkActivo">Activo</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1" id="btnGuardar">
                    <i class="bi bi-check-lg me-1"></i>Guardar
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">
                    Cancelar
                </button>
            </div>
        </form>
    </div>
</div>

@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@section Scripts {
    <script>
        window.apiSettings = {
            baseUrl: '@Configuration["ApiSettings:BaseUrl"]',
            endpointEspecialidad: '@Configuration["ApiSettings:EndpointEspecialidad"]'
        };
    </script>
    <script src="~/js/especialidades.js" asp-append-version="true"></script>
}