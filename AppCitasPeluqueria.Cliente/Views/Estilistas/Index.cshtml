@{
    ViewData["Title"] = "Estilistas";
}

 <!-- Cabecera de la sección con el botón para abrir el formulario -->
<div class="row g-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="h4 mb-1">Gestión de @ViewData["Title"]</h2>
            <p class="text-muted mb-0">Administra el registro y estado de tus estilistas.</p>
        </div>

        <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasEstilista" aria-controls="offcanvasEstilista" id="btnNuevoEstilista">
            <i class="bi bi-plus-lg me-1"></i>Nuevo estilista
        </button>
    </div>

    <!-- Listado -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <h3 class="h5 card-title mb-0">Listado de @ViewData["Title"]</h3>
                <span class="badge text-bg-secondary" id="contadorEstilistas">0</span>
            </div>
            <div id="errorServer" class="alert alert-danger d-none"></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-body-tertiary">
                            <tr>
                                <th>Nombre</th>
                                <th>Especialidad</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Activo</th> 
                                <th>Fecha de Creación</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tablaEstilistas">
                            <tr><td colspan="7" class="text-center text-muted py-4">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Offcanvas con el Formulario -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasEstilista" aria-labelledby="offcanvasEstilistaLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="tituloForm">Nuevo estilista</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="formEstilista" novalidate>
            <div id="errorForm" class="alert alert-danger d-none"></div>
            <div class="mb-3">
                <label for="inpNombre" class="form-label">Nombre</label>
                <input type="text" id="inpNombre" class="form-control" placeholder="Nombre completo" required />
            </div>

            <div class="mb-3">
                <label for="selectEspecialidad" class="form-label">Especialidad</label>
                <select id="selectEspecialidad" class="form-select" required>
                    <option value="">Seleccione una especialidad...</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="inpTelefono" class="form-label">Teléfono</label>
                <input type="tel" id="inpTelefono" class="form-control" placeholder="Teléfono" required />
            </div>

            <div class="mb-3">
                <label for="inpEmail" class="form-label">Email</label>
                <input type="email" id="inpEmail" class="form-control" placeholder="correo@ejemplo.com" required />
            </div>

            <div class="mb-4">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="chkActivo" checked>
                    <label class="form-check-label" for="chkActivo">Activo</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-check-lg me-1"></i>Guardar
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas" id="btnCancelar">
                    Cancelar
                </button>
            </div>
        </form>
    </div>
</div>

@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@section Scripts {
    <script>
        window.apiSettings = {
            baseUrl: '@Configuration["ApiSettings:BaseUrl"]',
            endpointEstilista: '@Configuration["ApiSettings:EndpointEstilista"]',
            endpointEspecialidad: '@Configuration["ApiSettings:EndpointEspecialidad"]'
        };
    </script>

    <script src="~/js/estilistas.js" asp-append-version="true"></script>
}