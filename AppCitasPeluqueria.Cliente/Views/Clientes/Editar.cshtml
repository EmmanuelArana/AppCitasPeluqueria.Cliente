@{
    ViewData["Title"] = "Cliente";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="h3 mb-0">@ViewData["Title"]</h3>
        <p class="text-muted mb-0">Edición de @ViewData["Title"]</p>
    </div>
</div>

<form id="formCliente" novalidate>
    <div id="errorForm" class="alert alert-danger d-none"></div>
    <div class="mb-3">
        <label for="inpNombre" class="form-label">Nombre</label>
        <input type="text" id="inpNombre" class="form-control" placeholder="Nombre completo" required />
    </div>

    <div class="mb-3">
        <label for="inpTelefono" class="form-label">Teléfono</label>
        <input type="tel" id="inpTelefono" class="form-control" placeholder="Teléfono" required />
    </div>

    <div class="mb-3">
        <label for="inpEmail" class="form-label">Email</label>
        <input type="email" id="inpEmail" class="form-control" placeholder="correo@ejemplo.com" required />
    </div>

    <div class="mb-4">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="chkActivo" checked>
            <label class="form-check-label" for="chkActivo">Activo</label>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">
            <i class="bi bi-check-lg me-1"></i>Actualizar
        </button>
        <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</form>

@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@section Scripts {
    <script>
        window.apiSettings = {
            baseUrl: '@Configuration["ApiSettings:BaseUrl"]',
            endpointCliente: '@Configuration["ApiSettings:EndpointCliente"]',
            clienteId: @(Context.Request.RouteValues["id"] ?? 0)
                };
    </script>

    <script src="~/js/Editar/editarClientes.js" asp-append-version="true"></script>
}